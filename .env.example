# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
# True locally; False on Render
DEBUG=True
ALLOWED_HOSTS=growsterr.com,www.growsterr.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://growsterr.com,https://www.growsterr.com
SITE_URL=https://growsterr.com

# --- Database ---
# Empty = SQLite at ./db.sqlite3. On Render: SQLITE_PATH=/var/data/db.sqlite3 (the persistent disk;
# the app refuses to start on Render without it, so a deploy can never wipe the users).
SQLITE_PATH=
# On Render: CACHE_DIR=/var/data/cache (rate limits shared by the gunicorn workers). Empty = in memory.
CACHE_DIR=
# Later, production moves to Supabase: the "Session pooler" string here wins over SQLite.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Email (Resend). Empty key = emails are printed to the console ---
# The same Resend account and verified sender domain as Sterr Agency (Growsterr is its product).
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Growsterr by Sterr Agency <noreply@sterragency.com>
TEAM_NOTIFY_EMAILS=ekinsipahi8@gmail.com
# Error alerts (500s, failed webhooks, app errors) go here; empty = TEAM_NOTIFY_EMAILS. Off when DEBUG=True.
ERROR_EMAILS=
CONTACT_EMAIL=hello@growsterr.com

# --- First admin user (created on deploy if missing; an existing password is never changed) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Growth packages (apps.growth): Stripe, accounts, the dashboard ---
# The Stripe account is SHARED with Sterr Agency, Linksterr and other sites. Growsterr only uses
# its own objects (prices growsterr_<plan>_monthly, metadata site=growsterr, its own webhook and
# portal configuration). 1) Put STRIPE_SECRET_KEY here and on Render  2) python manage.py setup_stripe
# (creates/updates only Growsterr's objects; writes STRIPE_WEBHOOK_SECRET here, never prints it).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# False = orders are taken as requests (team email + English auto-reply); True = Stripe Checkout.
GROWTH_PAYMENTS=False
# True = a confirmed email before the first payment (keeps card-testing scripts out).
GROWTH_VERIFY_EMAIL=True
# Package events also go to these (comma-separated), on top of TEAM_NOTIFY_EMAILS.
GROWTH_NOTIFY_EMAILS=ekinsipahi8@gmail.com
# Bearer token of the growth API (/growth/api/subscriptions/, /growth/api/stats/). Empty = API off.
GROWTH_API_TOKEN=
# Sign in with Google: Google Cloud -> OAuth client (Web). Authorized redirect URIs:
#   https://growsterr.com/account/google/complete/  and, locally, http://localhost:8000/account/google/complete/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Linksterr (delivery numbers + campaign sync). The same token is set on Linksterr. Empty = no sync.
LINKSTERR_API_URL=https://linksterr.com
LINKSTERR_AGENCY_TOKEN=

# --- Contact shown to customers (success page, emails) ---
WHATSAPP_NUMBER=905414487561
WHATSAPP_DISPLAY=+90 541 448 75 61
